MODEL_PROXY_URL=https://openrouter.ai/api/v1
MODEL_PROXY_API_KEY=<your_api_key_here>
LLM_DEFAULT=nvidia/nemotron-3-nano-30b-a3b
LLM_DEFAULT_EVAL=nvidia/nemotron-3-nano-30b-a3b

# You must list every model you plan to use here,
# otherwise the library will block the request before it's sent.
LLMS_AVAILABLE=nvidia/nemotron-3-nano-30b-a3b,openai/gpt-4o-mini,nvidia/nemotron-3-super-120b-a12b:free
PYTHONPATH=src
